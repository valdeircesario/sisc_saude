generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  nome      String
  telefone  String
  cpf       String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model UBS {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  telefone  String
  cnpj      String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funcionarios           Funcionario[]
  campanhas              Campanha[]
  consultas              Consulta[]
  solicitacoesInternacao SolicitacaoInternacao[]

  @@map("ubs")
}

model Hospital {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  telefone  String
  cnpj      String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitacoesInternacao    SolicitacaoInternacao[]
  procedimentosHospitalares ProcedimentoHospitalar[]
  solicitacaoExameHospital  SolicitacaoExameHospital[]
  agendamentosHospitalares  AgendamentoHospitalar[]
  internacoes               Internacao[]

  @@map("hospitais")
}

model Funcionario {
  id        String   @id @default(cuid())
  nome      String
  funcao    String
  crm       String?
  cpf       String   @unique
  telefone  String
  email     String   @unique
  senha     String
  ubsId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  ubs                      UBS                      @relation(fields: [ubsId], references: [id])
  historicoMedico          HistoricoMedico[]
  solicitacaoExame         SolicitacaoExame[]
  consultas                Consulta[]
  solicitacoesInternacao   SolicitacaoInternacao[]
  agendamentosHospitalares AgendamentoHospitalar[]
  internacoes              Internacao[]
  MedicacaoAdministrada    MedicacaoAdministrada[]
  vacinas   Vacina[] 

  @@map("funcionarios")
}

model Laboratorio {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  telefone  String
  cnpj      String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exames                   Exame[]
  solicitacaoExame         SolicitacaoExame[]
  solicitacaoExameHospital SolicitacaoExameHospital[]

  @@map("laboratorios")
}

model Paciente {
  id         String   @id @default(cuid())
  nome       String
  cpf        String   @unique
  cns        String   @unique
  endereco   String
  cep        String
  nascimento DateTime
  telefone   String
  email      String   @unique
  senha      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  historicoMedico           HistoricoMedico[]
  vacinas                   Vacina[]
  exames                    Exame[]
  solicitacaoExame          SolicitacaoExame[]
  solicitacaoExameHospital  SolicitacaoExameHospital[]
  consultas                 Consulta[]
  solicitacoesInternacao    SolicitacaoInternacao[]
  procedimentosHospitalares ProcedimentoHospitalar[]
  agendamentosHospitalares  AgendamentoHospitalar[]
  internacoes               Internacao[]
  medicacoesAdministradas   MedicacaoAdministrada[]

  @@map("pacientes")
}

model SolicitacaoInternacao {
  id            String    @id @default(cuid())
  pacienteId    String
  ubsId         String
  hospitalId    String
  funcionarioId String
  tipo          String // internacao, cirurgia
  motivo        String
  detalhes      String
  laudoMedico   String
  prioridade    String    @default("medio") // gravissimo, urgente, grave, medio, leve
  status        String    @default("pendente") // pendente, avaliando, agendado, realizado, cancelado
  dataAgendada  DateTime?
  horaAgendada  String?
  local         String?
  recomendacoes String?
  observacoes   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paciente      Paciente                 @relation(fields: [pacienteId], references: [id])
  ubs           UBS                      @relation(fields: [ubsId], references: [id])
  hospital      Hospital                 @relation(fields: [hospitalId], references: [id])
  funcionario   Funcionario              @relation(fields: [funcionarioId], references: [id])
  procedimentos ProcedimentoHospitalar[]
  agendamento   AgendamentoHospitalar[]
  internacao    Internacao? // Adicionado para linkar a internação criada a partir da solicitação

  @@map("solicitacoes_internacao")
}

model AgendamentoHospitalar {
  id                      String   @id @default(cuid())
  pacienteId              String
  hospitalId              String
  medicoId                String?
  solicitacaoInternacaoId String?
  dataAgendamento         DateTime
  horaAgendamento         String
  tipo                    String // consulta, cirurgia, exame
  status                  String   @default("agendado") // agendado, realizado, cancelado
  observacoes             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  paciente              Paciente               @relation(fields: [pacienteId], references: [id])
  hospital              Hospital               @relation(fields: [hospitalId], references: [id])
  medico                Funcionario?           @relation(fields: [medicoId], references: [id])
  solicitacaoInternacao SolicitacaoInternacao? @relation(fields: [solicitacaoInternacaoId], references: [id])

  @@map("agendamentos_hospitalares")
}

model ProcedimentoHospitalar {
  id                      String   @id @default(cuid())
  solicitacaoInternacaoId String
  pacienteId              String
  hospitalId              String
  medicoRealizouId        String?
  tipo                    String // cirurgia, internacao, tratamento
  descricao               String
  laudoPos                String?
  instrucoes              String?
  dataRealizacao          DateTime
  status                  String   @default("realizado") // realizado, em_andamento, cancelado
  observacoes             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  solicitacaoInternacao   SolicitacaoInternacao   @relation(fields: [solicitacaoInternacaoId], references: [id])
  paciente                Paciente                @relation(fields: [pacienteId], references: [id])
  hospital                Hospital                @relation(fields: [hospitalId], references: [id])
  medicoRealizou          Funcionario?            @relation(fields: [medicoRealizouId], references: [id])
  examesRelacionados      Exame[]
  medicacoesAdministradas MedicacaoAdministrada[]

  @@map("procedimentos_hospitalares")
}

model SolicitacaoExameHospital {
  id            String   @id @default(cuid())
  hospitalId    String
  laboratorioId String
  pacienteId    String
  tipoExame     String
  observacoes   String?
  status        String   @default("pendente") // pendente, agendado, realizado
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital    Hospital    @relation(fields: [hospitalId], references: [id])
  laboratorio Laboratorio @relation(fields: [laboratorioId], references: [id])
  paciente    Paciente    @relation(fields: [pacienteId], references: [id])

  @@map("solicitacao_exames_hospital")
}

model Campanha {
  id        String    @id @default(cuid())
  titulo    String
  descricao String
  tipo      String // vacinacao, consulta, exame, geral
  dataIni   DateTime
  dataFim   DateTime?
  ativa     Boolean   @default(true)
  ubsId     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ubs        UBS                 @relation(fields: [ubsId], references: [id])
  inscricoes InscricaoCampanha[]

  @@map("campanhas")
}

model InscricaoCampanha {
  id               String    @id @default(cuid())
  campanhaId       String
  nome             String
  cpf              String
  telefone         String
  email            String
  endereco         String?
  idade            Int?
  condicoesSaude   String? // diabetes, hipertensao, cardiopatia, etc
  prioridade       String    @default("normal") // alta, media, normal
  gravidade        String    @default("leve") // critico, grave, medio, leve
  pontuacao        Int       @default(0) // pontuacao calculada para classificacao
  observacoes      String?
  status           String    @default("inscrito") // inscrito, agendado, atendido
  dataAgendada     DateTime?
  horaAgendada     String?
  localAtendimento String?
  tipoAgendamento  String    @default("campanha") // campanha, normal
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campanha Campanha @relation(fields: [campanhaId], references: [id])

  @@map("inscricoes_campanhas")
}

model HistoricoMedico {
  id            String   @id @default(cuid())
  pacienteId    String
  funcionarioId String
  laudo         String
  doenca        String?
  diagnostico   String
  medicacao     String?
  observacoes   String?
  dataConsulta  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paciente                Paciente                @relation(fields: [pacienteId], references: [id])
  funcionario             Funcionario             @relation(fields: [funcionarioId], references: [id])
  medicacoesAdministradas MedicacaoAdministrada[]

  @@map("historico_medico")
}

model Vacina {
  id          String    @id @default(cuid())
  pacienteId  String
  funcionarioId String
  nome        String
  lote        String
  dataApl     DateTime
  proximaDose DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])
 

  @@map("vacinas")
}

model Exame {
  id            String    @id @default(cuid())
  pacienteId    String
  laboratorioId String
  tipo          String
  resultado     String?
  arquivoPdf    String?
  dataRealizado DateTime?
  dataAgendada  DateTime?
  status        String    @default("agendado") // agendado, realizado, cancelado
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paciente      Paciente                 @relation(fields: [pacienteId], references: [id])
  laboratorio   Laboratorio              @relation(fields: [laboratorioId], references: [id])
  procedimentos ProcedimentoHospitalar[]

  @@map("exames")
}

model SolicitacaoExame {
  id            String   @id @default(cuid())
  pacienteId    String
  funcionarioId String
  laboratorioId String
  tipoExame     String
  observacoes   String?
  status        String   @default("pendente") // pendente, agendado, realizado
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paciente    Paciente    @relation(fields: [pacienteId], references: [id])
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])
  laboratorio Laboratorio @relation(fields: [laboratorioId], references: [id])

  @@map("solicitacao_exames")
}

model Consulta {
  id            String    @id @default(cuid())
  pacienteId    String
  ubsId         String
  funcionarioId String?
  motivo        String
  especialidade String
  dataAgendada  DateTime?
  status        String    @default("solicitada") // solicitada, agendada, realizada, cancelada
  observacoes   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paciente    Paciente     @relation(fields: [pacienteId], references: [id])
  ubs         UBS          @relation(fields: [ubsId], references: [id])
  funcionario Funcionario? @relation(fields: [funcionarioId], references: [id])

  @@map("consultas")
}

model Internacao {
  id                      String    @id @default(cuid())
  solicitacaoInternacaoId String?   @unique // Adicionado para linkar à solicitação que gerou a internação
  pacienteId              String
  hospitalId              String
  medicoResponsavelNome   String // Alterado para armazenar o nome do médico responsável
  dataEntrada             DateTime
  dataSaida               DateTime?
  motivoInternacao        String // Renomeado para clareza
  diagnosticoInicial      String? // Renomeado para clareza
  quarto                  String
  leito                   String
  observacoes             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  paciente                Paciente                @relation(fields: [pacienteId], references: [id])
  hospital                Hospital                @relation(fields: [hospitalId], references: [id])
  solicitacaoInternacao   SolicitacaoInternacao?  @relation(fields: [solicitacaoInternacaoId], references: [id])
  medicacoesAdministradas MedicacaoAdministrada[]

  @@map("internacoes")
}

model MedicacaoAdministrada {
  id                       String   @id @default(cuid())
  pacienteId               String
  historicoMedicoId        String?
  procedimentoHospitalarId String?
  internacaoId             String?
  nomeMedicacao            String
  dosagem                  String?
  viaAdministracao         String?
  dataHoraAdministracao    DateTime
  administradorId          String?
  observacoes              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  paciente               Paciente                @relation(fields: [pacienteId], references: [id])
  historicoMedico        HistoricoMedico?        @relation(fields: [historicoMedicoId], references: [id])
  procedimentoHospitalar ProcedimentoHospitalar? @relation(fields: [procedimentoHospitalarId], references: [id])
  internacao             Internacao?             @relation(fields: [internacaoId], references: [id])
  administrador          Funcionario?            @relation(fields: [administradorId], references: [id])

  @@map("medicacoes_administradas")
}
