generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  nome      String
  telefone  String
  cpf       String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model UBS {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  telefone  String
  cnpj      String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funcionarios Funcionario[]
  campanhas    Campanha[]
  consultas    Consulta[]

  @@map("ubs")
}

model Hospital {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  telefone  String
  cnpj      String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  internacao    Internacao[]
  cirurgia     Ciru

  @@map("ubs")
}

model Funcionario {
  id        String   @id @default(cuid())
  nome      String
  funcao    String
  crm       String?
  cpf       String   @unique
  telefone  String
  email     String   @unique
  senha     String
  ubsId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ubs              UBS                @relation(fields: [ubsId], references: [id])
  historicoMedico  HistoricoMedico[]
  solicitacaoExame SolicitacaoExame[]
  consultas        Consulta[]

  @@map("funcionarios")
}

model Laboratorio {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  telefone  String
  cnpj      String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exames           Exame[]
  solicitacaoExame SolicitacaoExame[]

  @@map("laboratorios")
}

model Paciente {
  id          String    @id @default(cuid())
  nome        String
  cpf         String    @unique
  cns         String    @unique
  endereco    String
  cep         String
  nascimento  DateTime
  telefone    String
  email       String    @unique
  senha       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  historicoMedico  HistoricoMedico[]
  vacinas          Vacina[]
  exames           Exame[]
  solicitacaoExame SolicitacaoExame[]
  consultas        Consulta[]

  @@map("pacientes")
}

model Campanha {
  id        String   @id @default(cuid())
  titulo    String
  descricao String
  tipo      String   // vacinacao, consulta, exame, geral
  dataIni   DateTime
  dataFim   DateTime?
  ativa     Boolean  @default(true)
  ubsId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ubs UBS @relation(fields: [ubsId], references: [id])
  inscricoes InscricaoCampanha[]

  @@map("campanhas")
}

model InscricaoCampanha {
  id          String   @id @default(cuid())
  campanhaId  String
  nome        String
  cpf         String   @unique
  telefone    String
  email       String   @unique
  endereco    String?
  idade       Int?
  condicoesSaude String? // diabetes, hipertensao, cardiopatia, etc
  prioridade  String   @default("normal") // alta, media, normal
  gravidade   String   @default("leve") // critico, grave, medio, leve
  pontuacao   Int      @default(0) // pontuacao calculada para classificacao
  observacoes String?
  status      String   @default("inscrito") // inscrito, agendado, atendido
  dataAgendada DateTime?
  horaAgendada String?
  localAtendimento String?
  tipoAgendamento String @default("campanha") // campanha, normal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campanha Campanha @relation(fields: [campanhaId], references: [id])

  @@map("inscricoes_campanhas")
}
model HistoricoMedico {
  id           String   @id @default(cuid())
  pacienteId   String
  funcionarioId String
  laudo        String
  doenca       String?
  diagnostico  String
  medicacao    String?
  observacoes  String?
  dataConsulta DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paciente    Paciente    @relation(fields: [pacienteId], references: [id])
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])

  @@map("historico_medico")
}

model Vacina {
  id         String   @id @default(cuid())
  pacienteId String
  nome       String
  lote       String
  dataApl    DateTime
  proximaDose DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@map("vacinas")
}

model Exame {
  id             String   @id @default(cuid())
  pacienteId     String
  laboratorioId  String
  tipo           String
  resultado      String?
  arquivoPdf     String?
  dataRealizado  DateTime?
  dataAgendada   DateTime?
  status         String   @default("agendado") // agendado, realizado, cancelado
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  paciente    Paciente    @relation(fields: [pacienteId], references: [id])
  laboratorio Laboratorio @relation(fields: [laboratorioId], references: [id])

  @@map("exames")
}

model SolicitacaoExame {
  id            String   @id @default(cuid())
  pacienteId    String
  funcionarioId String
  laboratorioId String
  tipoExame     String
  observacoes   String?
  status        String   @default("pendente") // pendente, agendado, realizado
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paciente    Paciente    @relation(fields: [pacienteId], references: [id])
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])
  laboratorio Laboratorio @relation(fields: [laboratorioId], references: [id])

  @@map("solicitacao_exames")
}

model Consulta {
  id            String    @id @default(cuid())
  pacienteId    String
  ubsId         String
  funcionarioId String?
  motivo        String
  especialidade String
  dataAgendada  DateTime?
  status        String    @default("solicitada") // solicitada, agendada, realizada, cancelada
  observacoes   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paciente    Paciente     @relation(fields: [pacienteId], references: [id])
  ubs         UBS          @relation(fields: [ubsId], references: [id])
  funcionario Funcionario? @relation(fields: [funcionarioId], references: [id])

  @@map("consultas")
}