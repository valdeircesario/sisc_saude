generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  nome      String
  telefone  String
  cpf       String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model UBS {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  telefone  String
  cnpj      String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funcionarios           Funcionario[]
  campanhas              Campanha[]
  consultas              Consulta[]
  solicitacoesInternacao SolicitacaoInternacao[]

  @@map("ubs")
}

model Hospital {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  telefone  String
  cnpj      String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitacoesInternacao    SolicitacaoInternacao[]
  agendamentosHospitalares  AgendamentoHospitalar[]
  internacoes               Internacao[]
  examesHospitalares        ExameHospitalar[]
  cirurgias                 Cirurgia[]

  @@map("hospitais")
}

model Funcionario {
  id        String   @id @default(cuid())
  nome      String
  funcao    String
  crm       String?
  cpf       String   @unique
  telefone  String
  email     String   @unique
  senha     String
  ubsId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ubs                      UBS                      @relation(fields: [ubsId], references: [id])
  historicoMedico          HistoricoMedico[]
  solicitacaoExame         SolicitacaoExame[]
  consultas                Consulta[]
  solicitacoesInternacao   SolicitacaoInternacao[]
  agendamentosHospitalares AgendamentoHospitalar[]
  medicacoesAdministradas  MedicacaoAdministrada[]
  vacinas                  Vacina[]
  cirurgiasRealizadas      Cirurgia[]

  @@map("funcionarios")
}

model Laboratorio {
  id        String   @id @default(cuid())
  nome      String
  endereco  String
  telefone  String
  cnpj      String   @unique
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exames           Exame[]
  solicitacaoExame SolicitacaoExame[]

  @@map("laboratorios")
}

model Paciente {
  id         String   @id @default(cuid())
  nome       String
  cpf        String   @unique
  cns        String   @unique
  endereco   String
  cep        String
  nascimento DateTime
  telefone   String
  email      String   @unique
  senha      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  historicoMedico           HistoricoMedico[]
  vacinas                   Vacina[]
  exames                    Exame[]
  solicitacaoExame          SolicitacaoExame[]
  consultas                 Consulta[]
  solicitacoesInternacao    SolicitacaoInternacao[]
  agendamentosHospitalares  AgendamentoHospitalar[]
  internacoes               Internacao[]
  medicacoesAdministradas   MedicacaoAdministrada[]
  examesHospitalares        ExameHospitalar[]
  cirurgias                 Cirurgia[]
  altasHospitalares         AltaHospitalar[]

  @@map("pacientes")
}

model SolicitacaoInternacao {
  id            String    @id @default(cuid())
  pacienteId    String
  ubsId         String
  hospitalId    String
  funcionarioId String
  tipo          String // internacao, cirurgia
  motivo        String
  detalhes      String
  laudoMedico   String
  prioridade    String    @default("medio") // gravissimo, urgente, grave, medio, leve
  status        String    @default("pendente") // pendente, avaliando, agendado, realizado, cancelado
  dataAgendada  DateTime?
  horaAgendada  String?
  local         String?
  recomendacoes String?
  observacoes   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paciente      Paciente               @relation(fields: [pacienteId], references: [id])
  ubs           UBS                    @relation(fields: [ubsId], references: [id])
  hospital      Hospital               @relation(fields: [hospitalId], references: [id])
  funcionario   Funcionario            @relation(fields: [funcionarioId], references: [id])
  agendamentos  AgendamentoHospitalar[]
  internacao    Internacao? // Relação 1:1 - uma solicitação gera uma internação

  @@map("solicitacoes_internacao")
}

model AgendamentoHospitalar {
  id                      String   @id @default(cuid())
  pacienteId              String
  hospitalId              String
  medicoId                String?
  solicitacaoInternacaoId String?
  dataAgendamento         DateTime
  horaAgendamento         String
  tipo                    String // consulta, cirurgia, exame, internacao
  status                  String   @default("agendado") // agendado, realizado, cancelado
  observacoes             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  paciente              Paciente               @relation(fields: [pacienteId], references: [id])
  hospital              Hospital               @relation(fields: [hospitalId], references: [id])
  medico                Funcionario?           @relation(fields: [medicoId], references: [id])
  solicitacaoInternacao SolicitacaoInternacao? @relation(fields: [solicitacaoInternacaoId], references: [id])

  @@map("agendamentos_hospitalares")
}

// NOVA ESTRUTURA DE INTERNAÇÃO - CORRIGIDA
model Internacao {
  id                      String    @id @default(cuid())
  solicitacaoInternacaoId String    @unique // Relação 1:1 com solicitação
  pacienteId              String
  hospitalId              String
  medicoResponsavelNome   String
  dataEntrada             DateTime
  dataSaida               DateTime?
  motivoInternacao        String
  diagnosticoInicial      String?
  diagnosticoFinal        String? // Diagnóstico na alta
  quarto                  String
  leito                   String
  status                  String    @default("ativa") // ativa, alta, transferida, obito
  observacoes             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relacionamentos
  solicitacaoInternacao   SolicitacaoInternacao   @relation(fields: [solicitacaoInternacaoId], references: [id])
  paciente                Paciente                @relation(fields: [pacienteId], references: [id])
  hospital                Hospital                @relation(fields: [hospitalId], references: [id])
  
  // Atividades durante a internação
  medicacoesAdministradas MedicacaoAdministrada[]
  examesHospitalares      ExameHospitalar[]
  cirurgias               Cirurgia[]
  altaHospitalar          AltaHospitalar? // Relação 1:1 - uma internação tem uma alta

  @@map("internacoes")
}

// NOVA TABELA PARA EXAMES REALIZADOS NO HOSPITAL DURANTE A INTERNAÇÃO
model ExameHospitalar {
  id               String    @id @default(cuid())
  internacaoId     String
  pacienteId       String
  hospitalId       String
  tipoExame        String
  descricaoExame   String
  medicoSolicitante String
  resultado        String?
  arquivoPdf       String?
  dataRealizado    DateTime?
  dataSolicitado   DateTime
  status           String    @default("solicitado") // solicitado, realizado, cancelado
  observacoes      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  internacao Internacao @relation(fields: [internacaoId], references: [id])
  paciente   Paciente   @relation(fields: [pacienteId], references: [id])
  hospital   Hospital   @relation(fields: [hospitalId], references: [id])

  @@map("exames_hospitalares")
}

// NOVA TABELA PARA CIRURGIAS REALIZADAS DURANTE A INTERNAÇÃO
model Cirurgia {
  id                    String    @id @default(cuid())
  internacaoId          String
  pacienteId            String
  hospitalId            String
  medicoCircurgiaoId    String
  tipoCirurgia          String
  descricaoCirurgia     String
  dataRealizacao        DateTime
  duracaoMinutos        Int?
  anestesiaTipo         String?
  resultado             String // sucesso, complicacao, etc
  laudoCircurgico       String
  observacoes           String?
  status                String    @default("realizada") // agendada, realizada, cancelada
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  internacao      Internacao   @relation(fields: [internacaoId], references: [id])
  paciente        Paciente     @relation(fields: [pacienteId], references: [id])
  hospital        Hospital     @relation(fields: [hospitalId], references: [id])
  medicoCircurgiao Funcionario @relation(fields: [medicoCircurgiaoId], references: [id])

  @@map("cirurgias")
}

// NOVA TABELA PARA ALTA HOSPITALAR
model AltaHospitalar {
  id                    String   @id @default(cuid())
  internacaoId          String   @unique // Relação 1:1 com internação
  pacienteId            String
  medicoResponsavel     String
  dataAlta              DateTime
  tipoAlta              String // medica, a_pedido, transferencia, obito
  condicaoAlta          String // curado, melhorado, inalterado, agravado
  diagnosticoFinal      String
  orientacoesAlta       String
  medicacoesPrescritas  String? // Medicações para casa
  retornoAgendado       DateTime?
  observacoes           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  internacao Internacao @relation(fields: [internacaoId], references: [id])
  paciente   Paciente   @relation(fields: [pacienteId], references: [id])

  @@map("altas_hospitalares")
}

model MedicacaoAdministrada {
  id                    String   @id @default(cuid())
  pacienteId            String
  historicoMedicoId     String?
  internacaoId          String? // Relacionamento corrigido
  nomeMedicacao         String
  dosagem               String?
  viaAdministracao      String?
  dataHoraAdministracao DateTime
  administradorId       String?
  observacoes           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  paciente        Paciente         @relation(fields: [pacienteId], references: [id])
  historicoMedico HistoricoMedico? @relation(fields: [historicoMedicoId], references: [id])
  internacao      Internacao?      @relation(fields: [internacaoId], references: [id]) // Corrigido
  administrador   Funcionario?     @relation(fields: [administradorId], references: [id])

  @@map("medicacoes_administradas")
}

// TABELAS QUE PERMANECEM INALTERADAS (conforme solicitado)
model Campanha {
  id        String    @id @default(cuid())
  titulo    String
  descricao String
  tipo      String // vacinacao, consulta, exame, geral
  dataIni   DateTime
  dataFim   DateTime?
  ativa     Boolean   @default(true)
  ubsId     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ubs        UBS                 @relation(fields: [ubsId], references: [id])
  inscricoes InscricaoCampanha[]

  @@map("campanhas")
}

model InscricaoCampanha {
  id               String    @id @default(cuid())
  campanhaId       String
  nome             String
  cpf              String
  telefone         String
  email            String
  endereco         String?
  idade            Int?
  condicoesSaude   String?
  prioridade       String    @default("normal")
  gravidade        String    @default("leve")
  pontuacao        Int       @default(0)
  observacoes      String?
  status           String    @default("inscrito")
  dataAgendada     DateTime?
  horaAgendada     String?
  localAtendimento String?
  tipoAgendamento  String    @default("campanha")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campanha Campanha @relation(fields: [campanhaId], references: [id])

  @@map("inscricoes_campanhas")
}

model HistoricoMedico {
  id            String   @id @default(cuid())
  pacienteId    String
  funcionarioId String
  laudo         String
  doenca        String?
  diagnostico   String
  medicacao     String?
  observacoes   String?
  dataConsulta  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paciente                Paciente                @relation(fields: [pacienteId], references: [id])
  funcionario             Funcionario             @relation(fields: [funcionarioId], references: [id])
  medicacoesAdministradas MedicacaoAdministrada[]

  @@map("historico_medico")
}

model Vacina {
  id            String    @id @default(cuid())
  pacienteId    String
  funcionarioId String
  nome          String
  lote          String
  dataApl       DateTime
  proximaDose   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paciente    Paciente    @relation(fields: [pacienteId], references: [id])
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])

  @@map("vacinas")
}

model Exame {
  id            String    @id @default(cuid())
  pacienteId    String
  laboratorioId String
  tipo          String
  resultado     String?
  arquivoPdf    String?
  dataRealizado DateTime?
  dataAgendada  DateTime?
  status        String    @default("agendado")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paciente    Paciente    @relation(fields: [pacienteId], references: [id])
  laboratorio Laboratorio @relation(fields: [laboratorioId], references: [id])

  @@map("exames")
}

model SolicitacaoExame {
  id            String   @id @default(cuid())
  pacienteId    String
  funcionarioId String
  laboratorioId String
  tipoExame     String
  observacoes   String?
  status        String   @default("pendente")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paciente    Paciente    @relation(fields: [pacienteId], references: [id])
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])
  laboratorio Laboratorio @relation(fields: [laboratorioId], references: [id])

  @@map("solicitacao_exames")
}

model Consulta {
  id            String    @id @default(cuid())
  pacienteId    String
  ubsId         String
  funcionarioId String?
  motivo        String
  especialidade String
  dataAgendada  DateTime?
  status        String    @default("solicitada")
  observacoes   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paciente    Paciente     @relation(fields: [pacienteId], references: [id])
  ubs         UBS          @relation(fields: [ubsId], references: [id])
  funcionario Funcionario? @relation(fields: [funcionarioId], references: [id])

  @@map("consultas")
}